# Nusxalab .env nomida saqlang:  cp .env.example .env
# (VPS'da deploy/install.sh bu faylni o'zi yaratadi.)

# JWT kaliti. Bo'sh qoldirsangiz server o'zi yaratadi va DATA_DIR ga saqlaydi.
SECRET_KEY=

# Admin token amal qilish muddati (daqiqa)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS. Frontend va API bitta domendan beriladi, shuning uchun BO'SH qoldiring
# (butunlay yopiq -- eng xavfsiz). Faqat frontend BOSHQA domenda bo'lsagina:
#   ALLOWED_ORIGINS=https://domen.uz,https://www.domen.uz
ALLOWED_ORIGINS=

# Saytning ommaviy manzili (domen ulangach yozing). Konstruktordagi
# Telegram havolalari shu manzil bilan quriladi. Bo'sh bo'lsa so'rovdan olinadi.
# Masalan: PUBLIC_BASE_URL=https://domen.uz
PUBLIC_BASE_URL=

# Admin panelning boshlang'ich paroli (faqat baza birinchi marta yaratilganda).
# Bo'sh qoldirsangiz, server TASODIFIY parol yaratadi: konsolga/logga chiqaradi
# va DATA_DIR/.admin_password fayliga yozadi.
DEFAULT_ADMIN_PASSWORD=

# Proksi (nginx / Cloudflare Tunnel / Render) orqasida haqiqiy mijoz IP'sini
# aniqlash. Odatda O'ZGARTIRISH SHART EMAS:
#   auto  (standart) -- so'rov ishonchli proksidan (TRUSTED_PROXIES) kelsagina
#                       X-Forwarded-For / CF-Connecting-IP ga ishonadi.
#                       O'sha serverdagi nginx yoki cloudflared bilan sozlamasiz ishlaydi.
#   true  -- har doim ishonadi (Render kabi, backend to'g'ridan-to'g'ri ochiq bo'lmasa)
#   false -- hech qachon ishonmaydi
TRUST_X_FORWARDED_FOR=auto
# Ishonchli proksilar (IP/CIDR, vergul bilan) yoki "private" (ichki tarmoqlar).
TRUSTED_PROXIES=127.0.0.1,::1

# Development rejimi (faqat lokal ishlab chiqish uchun).
DEV_RELOAD=false

# Buyurtma rasmiylashtirilganda ochiladigan Telegram username.
DEFAULT_TELEGRAM_USERNAME=@laminated_glasses

# Sayt nomi
SITE_TITLE=Laminated Glasses

# --- Google orqali kirish -------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (turi: "Web application"). "Authorized JavaScript origins" ga saytingiz
# manzilini (https://domen.uz, https://www.domen.uz, lokal test uchun
# http://localhost:8000) QO'SHISH SHART -- aks holda "origin_mismatch" xatosi.
# O'ZINGIZNING loyihangiz Client ID'sini yozing. Standart qiymat yo'q.
GOOGLE_CLIENT_ID=

# Mijoz sessiyasi necha kun amal qiladi
CUSTOMER_TOKEN_EXPIRE_DAYS=30

# Savat necha kun saqlanadi
CART_TTL_DAYS=7

# Konstruktor: har bir Gmail uchun shuncha soatda 1 marta VA foydalanuvchilar
# yuklagan rasmlar shuncha soatdan keyin avtomatik o'chiriladi.
# (Buyurtmalar, yangiliklar, xavfsizlik jurnali AVTOMATIK O'CHIRILMAYDI.)
CONSTRUCTOR_LIMIT_HOURS=24
# Eski rasmlarni necha daqiqada bir tekshirish
CLEANUP_CHECK_MINUTES=30

# Baza, uploads/, maxfiy kalitlar saqlanadigan DOIMIY papka.
# Lokal ishlab chiqishda BO'SH qoldiring. VPS'da: /var/lib/laminated_glasses
# Render'da: Persistent Disk yo'li (/var/data).
DATA_DIR=

# Ixtiyoriy: Sentry (pip install -r requirements-optional.txt kerak)
SENTRY_DSN=
LOG_LEVEL=INFO
