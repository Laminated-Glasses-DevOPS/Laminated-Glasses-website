# Nusxalab .env nomida saqlang:  cp .env.example .env

# JWT kaliti. Bo'sh qoldirsangiz server o'zi yaratadi.
SECRET_KEY=

# Admin token amal qilish muddati (daqiqa)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS. Frontend backend bilan bitta portdan berilsa "*" kifoya.
# Production: ALLOWED_ORIGINS=https://sizning-domeningiz.uz
ALLOWED_ORIGINS=*

# Admin panelning boshlang'ich paroli (faqat baza birinchi marta yaratilganda).
# Bo'sh qoldirsangiz, server o'zi TASODIFIY va XAVFSIZ parol yaratadi va
# birinchi ishga tushishda konsolga (terminalga) chop etadi -- o'sha
# xabarni saqlab qoling. Faqat o'zingiz ongli ravishda kuchli parol
# tanlamoqchi bo'lsangiz shu yerga aniq yozing.
DEFAULT_ADMIN_PASSWORD=

# Xavfsizlik: "X-Forwarded-For" headeriga standart holatda ishonilmaydi
# (uni mijoz osongina soxtalashtirishi mumkin). Agar backend O'ZINGIZ
# ISHONADIGAN proksi (masalan o'z nginx serveringiz) orqasida ishlasa va
# haqiqiy mijoz IP manzilini shu header orqali uzatsa, true qiling.
# Cloudflare Tunnel ishlatilganda BUNGA EHTIYOJ YO'Q -- "CF-Connecting-IP"
# headeri avtomatik va xavfsiz tarzda ishlatiladi.
TRUST_X_FORWARDED_FOR=false

# Development rejimi: kod o'zgarganda serverni avtomatik qayta yuklaydi.
# Faqat lokal ishlab chiqish uchun -- production/tunnel serverida false
# qoldiring.
DEV_RELOAD=false

# Buyurtma rasmiylashtirilganda ochiladigan Telegram username.
DEFAULT_TELEGRAM_USERNAME=@laminated_glasses

# Sayt nomi
SITE_TITLE=Laminated Glasses

# Savat necha kun saqlanadi
CART_TTL_DAYS=7

# MUHIM (Render.com yoki shunga o'xshash platformalar uchun): kod papkasi
# har bir deploy'da yangidan yaratiladi, shu sabab baza fayli, uploads/,
# backups/ va admin parol/JWT kaliti fayllari ALOHIDA, DOIMIY diskka
# yozilishi kerak, aks holda har deploy'da hammasi yo'qoladi.
#
# Lokal ishlab chiqishda BO'SH qoldiring (backend/app papkasi ishlatiladi).
# Render'da "Persistent Disk" qo'shib, uni shu yerga ko'rsating, masalan:
# DATA_DIR=/var/data
DATA_DIR=
